# ── Sentinel config ── copy to .env (gitignored) and fill in. `./setup.sh` does this for you.

# Devin API key — app.devin.ai → Settings → API Keys. Format: apk_user_…
DEVIN_API_KEY=

# GitHub token for the automation on the target fork. Fine-grained PAT scoped to the fork:
#   Contents R/W · Issues R/W · Pull requests R/W · Commit statuses R/W · Administration R/W
# Optional for a dry run (Devin sessions still spawn); required for live checks / PRs / issues.
GH_PERSONAL_TOKEN=

# Target repository Sentinel guards (owner/name) and its default branch.
TARGET_REPO=Soham4001A/superset-cognition-demo
TARGET_BASE=master

# Public base URL the orchestrator advertises to GitHub for webhook delivery. For a laptop demo,
# expose :8080 with a tunnel (e.g. `cloudflared tunnel --url http://localhost:8080`) and paste the
# https URL here, then point a repo webhook at <PUBLIC_URL>/webhook/github. The dashboard's Demo
# Control buttons hit localhost directly, so the core demo works even without this set.
PUBLIC_URL=http://localhost:8080
